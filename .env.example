# Salin file ini menjadi ".env", lalu sesuaikan isinya.

# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Ganti "admin" dengan password PostgreSQL di laptop.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/db_w-allet

# Kunci untuk menandatangani cookie login. Isi dengan teks acak yang panjang.
SECRET_KEY=ganti-dengan-teks-acak-yang-panjang
